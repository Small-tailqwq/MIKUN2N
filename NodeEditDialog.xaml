<Window x:Class="MikuN2N.NodeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加节点" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackground}">
  <Window.Resources>
    <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="2,5,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="2,0,0,16">
      <TextBlock x:Name="HeaderText" Text="添加节点" FontSize="21" FontWeight="Bold" />
      <TextBlock Text="填写你自己搭建或朋友分享的节点服务器（supernode），一起联机的朋友需要使用同一个小组名称。"
                 TextWrapping="Wrap" Margin="0,5,0,0"
                 Foreground="{DynamicResource TextSecondary}" FontSize="12" />
    </StackPanel>

    <StackPanel Grid.Row="1">
      <TextBlock Text="节点名称" FontWeight="SemiBold" Margin="2,0,0,6" />
      <TextBox x:Name="NameBox" MaxLength="24" ToolTip="只在本机显示，用来区分多个节点"
               TextChanged="Field_TextChanged" />
      <TextBlock x:Name="NameError" Style="{StaticResource FieldError}" />
      <TextBlock Text="服务器地址" FontWeight="SemiBold" Margin="2,14,0,6" />
      <TextBox x:Name="ServerBox" ToolTip="形如 vps.example.com:3076；多个地址用逗号分隔"
               TextChanged="Field_TextChanged" />
      <TextBlock x:Name="ServerError" Style="{StaticResource FieldError}" />
      <TextBlock x:Name="ServerHintText" Margin="2,5,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondary}"
                 Text="例如 vps.example.com:3076 或 203.0.113.10:3076。多个地址用逗号分隔时，会按延迟自动选择。" />
      <TextBlock Text="小组名称" FontWeight="SemiBold" Margin="2,14,0,6" />
      <TextBox x:Name="CommunityBox" MaxLength="20"
               ToolTip="必须和朋友填写的完全一致（区分大小写）"
               TextChanged="Field_TextChanged" />
      <TextBlock x:Name="CommunityError" Style="{StaticResource FieldError}" />
      <TextBlock Margin="2,5,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondary}"
                 Text="不能包含空格，最长 20 个英文字符。填错会连不上，或看不到朋友。" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True" />
      <Button Content="确定" Width="100" Style="{StaticResource PrimaryButton}" IsDefault="True"
              Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>
