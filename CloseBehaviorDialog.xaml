<Window x:Class="MikuN2N.CloseBehaviorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 MikuN2N" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
  <Grid Margin="28" Background="{DynamicResource WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="关闭窗口后要做什么？" FontSize="22" FontWeight="Bold" />
    <TextBlock Grid.Row="1" Text="这次选择会被记住，你可以稍后在“设置”中修改。"
               Margin="0,7,0,20" Foreground="{DynamicResource TextSecondary}" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="MinimizeButton" Grid.Column="0" Click="Minimize_Click" Padding="18"
              HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource Accent}">
        <StackPanel>
          <TextBlock Text="最小化到托盘（推荐）" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="保持网络连接，隐藏主窗口。点击托盘图标即可恢复。"
                     TextWrapping="Wrap" Margin="0,7,0,0" FontWeight="Normal"
                     Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Click="Exit_Click" Padding="18" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <TextBlock Text="退出程序" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="断开虚拟局域网并退出，正在进行的联机会中断。"
                     TextWrapping="Wrap" Margin="0,7,0,0" FontWeight="Normal"
                     Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
      </Button>
    </Grid>
    <Button Grid.Row="3" Content="取消" Width="90" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" />
  </Grid>
</Window>
