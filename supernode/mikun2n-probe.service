[Unit]
Description=MikuN2N NAT observation (__SERVICE_NAME__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u __PROBE_FILE__ server --bind 0.0.0.0 --port-a 21001 --port-b 21002
Restart=on-failure
RestartSec=3s
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
