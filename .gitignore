bin/
obj/
publish/
dist/
artifacts/
logs/
*.log
*.user
*.suo
.vs/
.claude/
*.zip

# Local tooling build outputs; rebuild the natpunch tools with the commands in the
# mikun2n-edge-patch skill instead of committing the binaries.
__pycache__/
tools/**/*.exe

# Runtime/ ships third-party binaries intentionally (see Runtime/README.txt) — do not ignore it.
!Runtime/
!Runtime/**
Runtime/*.bak*

# Local agent overrides may carry machine-specific paths, personal server addresses and
# group names. Never commit them; the tracked instruction files must stay generic.
*.local.md
AGENTS.local.md
CLAUDE.local.md
