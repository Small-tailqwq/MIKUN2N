<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MikuN2N</AssemblyName>
    <RootNamespace>MikuN2N</RootNamespace>
    <BaseVersion>0.5.8</BaseVersion>
    <BuildNumber>5</BuildNumber>
    <Version>$(BaseVersion)-$(BuildNumber)</Version>
    <AssemblyVersion>$(BaseVersion).0</AssemblyVersion>
    <FileVersion>$(BaseVersion).$(BuildNumber)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/MikuN2N</PathMap>
    <!-- GitHub "owner/name" whose releases the in-app updater follows. Forks point this at
         their own repository; "none" builds a client that never checks for updates. -->
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">Small-tailqwq/MikuN2N</UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\offline-tests\**\*.cs" />
    <EmbeddedResource Remove="tools\offline-tests\**\*" />
    <None Remove="tools\offline-tests\bin\**\*;tools\offline-tests\obj\**\*" />
    <Compile Remove="native\**" />
    <None Remove="native\**" />
    <Content Include="Runtime\n3n-edge.exe;Runtime\n3n-3.4.4-source.zip;Runtime\LICENSE-n2n.txt;Runtime\LICENSE-tap-windows.txt;Runtime\LICENSE-dotnet.txt;Runtime\THIRD-PARTY-NOTICES.txt;Runtime\THIRD-PARTY-NOTICES-dotnet.txt;Runtime\README.txt;Runtime\tap-windows-installer.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="LICENSE" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(TestProfilePath)' != ''">
    <EmbeddedResource Include="$(TestProfilePath)" LogicalName="MikuN2N.PrivateTestProfile" />
  </ItemGroup>

  <Target Name="ValidateTestProfile" BeforeTargets="PrepareForBuild" Condition="'$(TestProfilePath)' != ''">
    <Error Condition="!Exists('$(TestProfilePath)')" Text="The private test profile does not exist." />
  </Target>

  <Target Name="WriteBuildIdentity" AfterTargets="Build">
    <WriteLinesToFile
      File="$(TargetDir)build-identity.txt"
      Lines="$(InformationalVersion)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <Target Name="WritePublishedBuildIdentity" AfterTargets="Publish">
    <WriteLinesToFile
      File="$(PublishDir)build-identity.txt"
      Lines="$(InformationalVersion)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

</Project>
