<Window x:Class="MikuN2N.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikuN2N 联机助手"
        Width="920" Height="820" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="MetricValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource LogoGradient}" Margin="0,0,14,0">
            <TextBlock Text="M" FontSize="27" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="MikuN2N" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="和朋友像在同一个局域网一样联机" FontSize="13" Margin="1,3,0,0"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="13"
                    Padding="12,8" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="VersionBadgeText" Text="v开发版"
                         Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="12"
                         VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <Button Content="⚙  设置" Style="{StaticResource QuietButton}" Click="SettingsButton_Click" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Accent}" CornerRadius="16,0,0,16" />
            <Grid Grid.Column="1" Margin="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border x:Name="StatusIndicator" Grid.RowSpan="2" Width="66" Height="66"
                      CornerRadius="33" Background="#AAB1C0" HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                <TextBlock x:Name="StatusGlyph" Text="○" FontSize="32" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="StatusTitle" Text="尚未连接" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="StatusDetail" Text="填写昵称后点击连接，即可加入朋友们的虚拟局域网。"
                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" />
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="9"
                        Padding="9,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                  <TextBlock x:Name="RoomNameText" Text="房间：—" FontSize="11"
                             Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                </Border>
              </StackPanel>
              <Grid Grid.Row="1" Grid.Column="1" Margin="0,19,0,0" UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="虚拟 IP" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="VirtualIpText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="在线朋友" ToolTip="由本机好友心跳确认的其他 MikuN2N 节点。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="PeerCountText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="P2P 直连" ToolTip="不经过 Supernode 中继的好友数量。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="DirectCountText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Text="NAT 类型" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <Border x:Name="NatTypeBadge" Margin="0,4,0,0" Padding="7,3"
                          HorizontalAlignment="Left" CornerRadius="8"
                          Background="{DynamicResource SurfaceAlt}"
                          BorderBrush="{DynamicResource Border}" BorderThickness="1"
                          Cursor="Help" ToolTipService.InitialShowDelay="180">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="NatHealthDot" Text="●" FontSize="9"
                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                 Foreground="{DynamicResource TextMuted}" />
                      <TextBlock x:Name="NatTypeText" Text="—"
                                 FontFamily="Segoe UI Variable Text, Segoe UI"
                                 FontWeight="SemiBold" FontSize="13"
                                 TextOptions.TextFormattingMode="Ideal"
                                 TextOptions.TextRenderingMode="Grayscale"
                                 TextOptions.TextHintingMode="Fixed"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <Border.ToolTip>
                      <ToolTip ContentTemplate="{x:Null}" Placement="Mouse">
                        <StackPanel Orientation="Horizontal">
                          <Border x:Name="Nat1LegendBorder" Width="54" CornerRadius="7"
                                  Background="#2CB47D" BorderBrush="White" BorderThickness="1"
                                  Margin="0,0,4,0">
                            <Grid>
                              <Border x:Name="Nat1MutedOverlay" Background="#92778088" CornerRadius="6" />
                              <TextBlock Text="NAT1" Foreground="White" FontWeight="Bold"
                                         HorizontalAlignment="Center" Margin="7,5" />
                            </Grid>
                          </Border>
                          <Border x:Name="Nat2LegendBorder" Width="54" CornerRadius="7"
                                  Background="#35B8C5" BorderBrush="White" BorderThickness="1"
                                  Margin="0,0,4,0">
                            <Grid>
                              <Border x:Name="Nat2MutedOverlay" Background="#92778088" CornerRadius="6" />
                              <TextBlock Text="NAT2" Foreground="White" FontWeight="Bold"
                                         HorizontalAlignment="Center" Margin="7,5" />
                            </Grid>
                          </Border>
                          <Border x:Name="Nat3LegendBorder" Width="54" CornerRadius="7"
                                  Background="#E69E34" BorderBrush="White" BorderThickness="1"
                                  Margin="0,0,4,0">
                            <Grid>
                              <Border x:Name="Nat3MutedOverlay" Background="#92778088" CornerRadius="6" />
                              <TextBlock Text="NAT3" Foreground="White" FontWeight="Bold"
                                         HorizontalAlignment="Center" Margin="7,5" />
                            </Grid>
                          </Border>
                          <Border x:Name="Nat4LegendBorder" Width="54" CornerRadius="7"
                                  Background="#E25259" BorderBrush="White" BorderThickness="1">
                            <Grid>
                              <Border x:Name="Nat4MutedOverlay" Background="#92778088" CornerRadius="6" />
                              <TextBlock Text="NAT4" Foreground="White" FontWeight="Bold"
                                         HorizontalAlignment="Center" Margin="7,5" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </ToolTip>
                    </Border.ToolTip>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="连接时间" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TapWarningBorder" Grid.ColumnSpan="3" Background="{DynamicResource WarningSoft}"
                    BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="10"
                    Padding="13,10" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="需要安装虚拟网卡" FontWeight="SemiBold" />
                  <TextBlock x:Name="TapStatusText" Text="首次使用请先安装，完成后就不需要重复操作。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,10,0" />
                </StackPanel>
                <Button x:Name="InstallTapButton" Grid.Column="1" Content="安装网络组件"
                        MinHeight="34" Padding="13,5" Click="InstallTapButton_Click" />
              </Grid>
            </Border>

            <TextBlock Grid.Row="1" Text="你的昵称" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="联机密钥" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBox x:Name="NicknameBox" Grid.Row="2" MaxLength="31" ToolTip="朋友列表中显示的名字" />
            <PasswordBox x:Name="KeyBox" Grid.Row="2" Grid.Column="2" MaxLength="64"
                         ToolTip="朋友之间需使用相同密钥；留空表示不加密" />
            <TextBlock Grid.Row="3" Text="朋友会通过这个名字辨认你。" Margin="1,6,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" />
            <CheckBox x:Name="RememberKeyBox" Grid.Row="3" Grid.Column="2"
                      Content="在这台电脑上安全记住密钥" Margin="1,7,0,0" />
            <Button x:Name="ConnectButton" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,21,0,0"
                    Height="50" Content="连接到 mygroup" FontSize="16"
                    Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" />
          </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="联机好友" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="显示同一 n3n 网络中也启动了 MikuN2N 的朋友。"
                           Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource SuccessSoft}" CornerRadius="11" Padding="10,4"
                      VerticalAlignment="Center">
                <TextBlock Text="自动发现" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <Grid>
              <DataGrid x:Name="PeersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                        MinHeight="88" MaxHeight="228" RowHeight="38" ColumnHeaderHeight="34"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="昵称" Width="2*" MaxWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Nickname}" ToolTip="{Binding Nickname}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="虚拟 IP" Width="*" MinWidth="108">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding VirtualIp}" ToolTip="右键复制虚拟 IP"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   MouseRightButtonUp="PeerIpText_MouseRightButtonUp" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="延迟" Binding="{Binding LatencyText}" Width="*" />
                  <DataGridTemplateColumn Header="链路" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ConnectionModeText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MouseRightButtonUp="PeerModeText_MouseRightButtonUp">
                          <TextBlock.ToolTip>
                            <ToolTip>
                              <StackPanel MaxWidth="280">
                                <TextBlock Text="{Binding ConnectionModeText}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="右键：强制/取消 pSp 中继；处于 pSp 中继时可重新尝试 P2P 打洞。"
                                           TextWrapping="Wrap" Margin="0,3,0,0" Opacity="0.75" />
                              </StackPanel>
                            </ToolTip>
                          </TextBlock.ToolTip>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="PeersEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False">
                <TextBlock Text="◎" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="连接后，在线朋友会自动出现在这里。" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Expander Grid.Row="4" Header="高级连接设置" Margin="3,1,3,13">
          <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="服务器" FontWeight="SemiBold" Margin="0,0,0,7" />
              <TextBlock Grid.Column="2" Text="小组名称" FontWeight="SemiBold" Margin="0,0,0,7" />
              <TextBox x:Name="ServerBox" Grid.Row="1" />
              <TextBox x:Name="CommunityBox" Grid.Row="1" Grid.Column="2" MaxLength="20"
                       TextChanged="CommunityBox_TextChanged" />
            </Grid>
          </Border>
        </Expander>

        <Expander Grid.Row="5" Header="运行日志" Margin="3,0,3,0">
          <Border Background="{DynamicResource LogBackground}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
            <TextBox x:Name="LogBox" Height="160" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     VerticalContentAlignment="Stretch"
                     Background="{DynamicResource LogBackground}" Foreground="{DynamicResource LogText}"
                     BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
          </Border>
        </Expander>
      </Grid>
    </ScrollViewer>
    <Canvas x:Name="EasterEggOverlay" Panel.ZIndex="100" IsHitTestVisible="False" />
  </Grid>
</Window>
