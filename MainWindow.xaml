<Window x:Class="MikuN2N.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikuN2N 联机助手"
        Width="920" Height="820" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="MetricValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBackground}">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
      <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource LogoGradient}" Margin="0,0,14,0">
            <TextBlock Text="M" FontSize="27" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="MikuN2N" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="和朋友像在同一个局域网一样联机" FontSize="13" Margin="1,3,0,0"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="13"
                    Padding="12,8" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="VersionBadgeText" Text="v开发版"
                         Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"
                         VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <Button Content="⚙  设置" Style="{StaticResource QuietButton}" Click="SettingsButton_Click"
                    AutomationProperties.Name="设置" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Accent}" CornerRadius="16,0,0,16" />
            <Grid Grid.Column="1" Margin="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border x:Name="StatusIndicator" Grid.RowSpan="2" Width="66" Height="66"
                      CornerRadius="33" Background="#AAB1C0" HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                <TextBlock x:Name="StatusGlyph" Text="○" FontSize="32" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="StatusTitle" Text="尚未连接" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="StatusDetail" Text="填写昵称后点击连接，即可加入朋友们的虚拟局域网。"
                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" MinHeight="36"
                           Foreground="{DynamicResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Border Background="{DynamicResource AccentSoft}" CornerRadius="9"
                          Padding="9,4" HorizontalAlignment="Left">
                    <TextBlock x:Name="RoomNameText" Text="小组：—" FontSize="11"
                               Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" />
                  </Border>
                  <Border x:Name="SupernodeBadge" Background="{DynamicResource AccentSoft}"
                          CornerRadius="9" Padding="9,4" Margin="6,0,0,0"
                          HorizontalAlignment="Left" Visibility="Collapsed"
                          ToolTip="当前连接的节点服务器（多个地址时按延迟自动选择）；朋友之间无法直连时由它中转数据。">
                    <TextBlock x:Name="SupernodeText" Text="节点：—" FontSize="11"
                               Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="1" Grid.Column="1" Margin="0,19,0,0" UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="VirtualIpLabel" Text="虚拟 IP"
                             Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="VirtualIpText" Text="—" Style="{StaticResource MetricValueText}"
                             MouseLeftButtonUp="VirtualIpText_MouseLeftButtonUp" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="在线朋友" ToolTip="已发现且在线的朋友数量。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="PeerCountText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="直连朋友" ToolTip="与你直接相连、不经服务器中转的朋友数量。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="DirectCountText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Text="NAT 类型" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <Border x:Name="NatTypeBadge" Margin="0,4,0,0" Padding="7,3"
                          HorizontalAlignment="Left" CornerRadius="8"
                          Background="{DynamicResource SurfaceAlt}"
                          BorderBrush="{DynamicResource Border}" BorderThickness="1"
                          Cursor="Help" ToolTipService.InitialShowDelay="180"
                          ToolTipService.ShowDuration="20000">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="NatHealthDot" Text="●" FontSize="9"
                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                 Foreground="{DynamicResource TextMuted}" />
                      <TextBlock x:Name="NatTypeText" Text="—"
                                 FontFamily="Segoe UI Variable Text, Segoe UI"
                                 FontWeight="SemiBold" FontSize="13"
                                 TextOptions.TextFormattingMode="Ideal"
                                 TextOptions.TextRenderingMode="Grayscale"
                                 TextOptions.TextHintingMode="Fixed"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <Border.ToolTip>
                      <ToolTip Placement="Mouse">
                        <StackPanel MaxWidth="300">
                          <StackPanel Orientation="Horizontal">
                            <Border x:Name="Nat1LegendBorder" Width="54" CornerRadius="7"
                                    Background="#2CB47D" BorderBrush="Transparent" BorderThickness="1"
                                    Margin="0,0,4,0">
                              <Grid>
                                <Border x:Name="Nat1MutedOverlay" Background="#92778088" CornerRadius="6" />
                                <TextBlock Text="NAT1" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="7,5" />
                              </Grid>
                            </Border>
                            <Border x:Name="Nat2LegendBorder" Width="54" CornerRadius="7"
                                    Background="#35B8C5" BorderBrush="Transparent" BorderThickness="1"
                                    Margin="0,0,4,0">
                              <Grid>
                                <Border x:Name="Nat2MutedOverlay" Background="#92778088" CornerRadius="6" />
                                <TextBlock Text="NAT2" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="7,5" />
                              </Grid>
                            </Border>
                            <Border x:Name="Nat3LegendBorder" Width="54" CornerRadius="7"
                                    Background="#E69E34" BorderBrush="Transparent" BorderThickness="1"
                                    Margin="0,0,4,0">
                              <Grid>
                                <Border x:Name="Nat3MutedOverlay" Background="#92778088" CornerRadius="6" />
                                <TextBlock Text="NAT3" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="7,5" />
                              </Grid>
                            </Border>
                            <Border x:Name="Nat4LegendBorder" Width="54" CornerRadius="7"
                                    Background="#E25259" BorderBrush="Transparent" BorderThickness="1">
                              <Grid>
                                <Border x:Name="Nat4MutedOverlay" Background="#92778088" CornerRadius="6" />
                                <TextBlock Text="NAT4" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="7,5" />
                              </Grid>
                            </Border>
                          </StackPanel>
                          <TextBlock x:Name="NatExplainText" Margin="0,9,0,0" TextWrapping="Wrap" FontSize="12"
                                     Text="连接后会自动检测你的网络类型。" />
                          <TextBlock x:Name="NetworkHintText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                     Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                        </StackPanel>
                      </ToolTip>
                    </Border.ToolTip>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="连接时间" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                  <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TapWarningBorder" Grid.ColumnSpan="3" Background="{DynamicResource WarningSoft}"
                    BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="10"
                    Padding="13,10" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="需要安装虚拟网卡" FontWeight="SemiBold" />
                  <TextBlock x:Name="TapStatusText" Text="首次使用请先安装，完成后就不需要重复操作。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,10,0" />
                </StackPanel>
                <Button x:Name="InstallTapButton" Grid.Column="1" Content="安装网络组件"
                        MinHeight="34" Padding="13,5" Click="InstallTapButton_Click" />
              </Grid>
            </Border>

            <Border x:Name="NoNodeBorder" Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10"
                    Padding="13,10" Margin="0,0,0,18" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="还没有节点" FontWeight="SemiBold" />
                  <TextBlock Text="填入朋友分享（或自己搭建）的服务器地址和小组名称，就可以开始联机。"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" Margin="0,2,10,0" />
                </StackPanel>
                <Button x:Name="AddFirstNodeButton" Grid.Column="1" Content="添加节点"
                        MinHeight="34" Padding="13,5" Click="AddFirstNode_Click" />
              </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="你的昵称" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="联机密钥" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBox x:Name="NicknameBox" Grid.Row="3" MaxLength="31" ToolTip="朋友列表中显示的名字"
                     ToolTipService.ShowOnDisabled="True"
                     TextChanged="NicknameBox_TextChanged" KeyDown="ConnectInput_KeyDown" />
            <Grid Grid.Row="3" Grid.Column="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="KeyBox" MaxLength="64"
                           ToolTip="朋友之间需使用相同密钥；留空表示不加密"
                           ToolTipService.ShowOnDisabled="True"
                           PasswordChanged="KeyBox_PasswordChanged" KeyDown="ConnectInput_KeyDown" />
              <TextBox x:Name="KeyPlainBox" MaxLength="64" Visibility="Collapsed"
                       ToolTip="朋友之间需使用相同密钥；留空表示不加密"
                       TextChanged="KeyPlainBox_TextChanged" KeyDown="ConnectInput_KeyDown" />
              <Button x:Name="KeyRevealButton" Grid.Column="1" Content="显示" Margin="6,0,0,0"
                      MinWidth="58" Style="{StaticResource QuietButton}"
                      AutomationProperties.Name="显示或隐藏联机密钥"
                      ToolTip="显示或隐藏密钥，方便核对朋友发来的内容"
                      Click="KeyRevealButton_Click" />
            </Grid>
            <TextBlock x:Name="NicknameHintText" Grid.Row="4" Text="朋友会通过这个名字辨认你。"
                       Margin="1,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
            <CheckBox x:Name="RememberKeyBox" Grid.Row="4" Grid.Column="2"
                      Content="在这台电脑上安全记住密钥" Margin="1,7,0,0" />
            <Button x:Name="ConnectButton" Grid.Row="5" Grid.ColumnSpan="3" Margin="0,21,0,0"
                    Height="50" Content="连接" FontSize="16"
                    Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" />
            <TextBlock x:Name="ConnectErrorText" Grid.Row="6" Grid.ColumnSpan="3" Margin="2,10,0,0"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Danger}"
                       Visibility="Collapsed" />
          </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="联机好友" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="显示同一小组里也打开了 MikuN2N 的朋友；右键某一行可复制 IP 或切换线路。"
                           TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Border x:Name="DiscoveryBadge" Grid.Column="1" Background="{DynamicResource SuccessSoft}"
                      CornerRadius="11" Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed"
                      ToolTip="已连接时会自动发现同一小组里的朋友。">
                <TextBlock Text="自动发现中" Foreground="{DynamicResource SuccessText}" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <Grid>
              <DataGrid x:Name="PeersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        PreviewMouseWheel="PeersGrid_PreviewMouseWheel"
                        PreviewMouseRightButtonUp="PeersGrid_PreviewMouseRightButtonUp"
                        PreviewKeyDown="PeersGrid_PreviewKeyDown"
                        CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                        CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                        HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                        MinHeight="88" MaxHeight="228" RowHeight="38" ColumnHeaderHeight="34"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="昵称" Width="1.5*" MinWidth="90" SortMemberPath="Nickname">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Nickname}" ToolTip="{Binding Nickname}"
                                   Style="{StaticResource CellText}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="虚拟 IP" Width="118" SortMemberPath="VirtualIp">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding VirtualIp}" ToolTip="右键可复制虚拟 IP"
                                   Style="{StaticResource CellText}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="延迟" Binding="{Binding LatencyText}" Width="78"
                                      SortMemberPath="LatencyMs" ElementStyle="{StaticResource CellText}" />
                  <DataGridTemplateColumn Header="版本" Width="0.8*" MinWidth="70" SortMemberPath="VersionText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding VersionText}" ToolTip="{Binding VersionDetail}"
                                   Style="{StaticResource CellText}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="链路" Width="1.7*" MinWidth="128" SortMemberPath="ConnectionModeText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ConnectionModeText}" Style="{StaticResource CellText}">
                          <TextBlock.ToolTip>
                            <ToolTip>
                              <StackPanel MaxWidth="280">
                                <TextBlock Text="{Binding ConnectionModeText}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConnectionModeDescription}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="右键可复制 IP、重新尝试直连或切换线路。"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                              </StackPanel>
                            </ToolTip>
                          </TextBlock.ToolTip>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72"
                                      ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="PeersEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False" Margin="12,34,12,0">
                <TextBlock Text="◎" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                <TextBlock x:Name="PeersEmptyDetail" Text="连接后，在线朋友会自动出现在这里。" Margin="0,5,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Expander Grid.Row="4" Header="当前节点" IsExpanded="True" Margin="3,1,3,13">
          <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18*" /><ColumnDefinition Width="16" />
                <ColumnDefinition Width="24*" /><ColumnDefinition Width="16" />
                <ColumnDefinition Width="18*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="5" Text="节点由你自建或朋友分享，可在设置里添加和维护。"
                         Foreground="{DynamicResource TextSecondary}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Grid.Row="1" Text="节点" FontWeight="SemiBold" Margin="0,0,0,7" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="地址" FontWeight="SemiBold" Margin="0,0,0,7" />
              <TextBlock Grid.Row="1" Grid.Column="4" Text="小组名称" FontWeight="SemiBold" Margin="0,0,0,7" />
              <ComboBox x:Name="NodeBox" Grid.Row="2" DisplayMemberPath="Name"
                        SelectionChanged="NodeBox_SelectionChanged"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="选择要连接的节点" />
              <TextBlock x:Name="NodeAddressText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock x:Name="NodeCommunityText" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
              <Button x:Name="ManageNodesButton" Grid.Row="3" Grid.ColumnSpan="5"
                      Content="管理节点…" Click="ManageNodes_Click"
                      ToolTipService.ShowOnDisabled="True"
                      HorizontalAlignment="Left" Margin="0,12,0,0" />
            </Grid>
          </Border>
        </Expander>

        <StackPanel Grid.Row="5">
          <Border x:Name="DiagnosticsPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceAlt}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <DockPanel>
              <Button x:Name="StopUploadButton" DockPanel.Dock="Right" Content="停止上传" IsEnabled="False"
                      Click="StopUpload_Click" Margin="12,0,0,0" Padding="12,6" />
              <Button x:Name="ResumeDiagnosticsButton" DockPanel.Dock="Right" Content="恢复日志" IsEnabled="False"
                      Click="ResumeDiagnostics_Click" Margin="12,0,0,0" Padding="12,6"
                      ToolTip="恢复记录或重新授权上传，不会重连" />
              <TextBlock x:Name="DiagnosticsStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" />
            </DockPanel>
          </Border>
          <Expander Header="运行日志" Margin="3,0,3,0">
            <Border Background="{DynamicResource LogBackground}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="打开日志目录"
                        Style="{StaticResource QuietButton}" Foreground="{DynamicResource LogText}"
                        MinHeight="30" Padding="10,4" Margin="0,-6,-6,6" Click="OpenLogFolder_Click" />
                <TextBox x:Name="LogBox" Height="160" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         VerticalContentAlignment="Stretch"
                         Background="{DynamicResource LogBackground}" Foreground="{DynamicResource LogText}"
                         BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
              </DockPanel>
            </Border>
          </Expander>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Canvas x:Name="EasterEggOverlay" Panel.ZIndex="100" IsHitTestVisible="False" />
  </Grid>
</Window>
