<Window x:Class="MikuN2N.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MikuN2N.Models"
        Title="MikuN2N 联机助手"
        Width="920" Height="820" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="MetricValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBackground}">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
      <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="48" Height="48" Source="{StaticResource MikuN2NLogo}"
                 Stretch="Uniform" Margin="0,0,14,0" AutomationProperties.Name="MikuN2N 标志" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="MikuN2N" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="和朋友像在同一个局域网一样联机" FontSize="13" Margin="1,3,0,0"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UpdateReadyButton" Content="更新已就绪" Visibility="Collapsed"
                    Style="{StaticResource QuietButton}" Click="UpdateReady_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="查看已准备好的更新" />
            <Border x:Name="VersionBadgeBorder" Background="{DynamicResource AccentSoft}" CornerRadius="13"
                    Padding="12,8" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="VersionBadgeText" Text="v开发版"
                         Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"
                         VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <Button Content="⚙  设置" Style="{StaticResource QuietButton}" Click="SettingsButton_Click"
                    AutomationProperties.Name="设置" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="20,20,20,18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
              <Border x:Name="StatusPanel" Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="18,16">
                <Grid>
                  <Border x:Name="StatusTransitionOverlay" CornerRadius="10" Margin="-18,-16"
                          Opacity="0" IsHitTestVisible="False" />
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="联机状态" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      <TextBlock x:Name="RoomNameText" Grid.Column="1" Text="小组：—" Margin="14,0,0,0"
                                 FontSize="12" Foreground="{DynamicResource AccentText}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border x:Name="StatusIndicator" Width="38" Height="38" CornerRadius="9" Margin="0,0,12,0"
                              Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                              BorderThickness="1" VerticalAlignment="Top">
                        <Path x:Name="StatusGlyph" Width="24" Height="24" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="2.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Data="M 12,4 A 8,8 0 1 1 12,20 A 8,8 0 1 1 12,4"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                              IsHitTestVisible="False">
                          <Path.RenderTransform>
                            <TransformGroup>
                              <ScaleTransform x:Name="StatusGlyphScale" />
                              <RotateTransform x:Name="StatusGlyphRotation" />
                              <TranslateTransform x:Name="StatusGlyphOffset" />
                            </TransformGroup>
                          </Path.RenderTransform>
                        </Path>
                      </Border>
                      <TextBlock x:Name="StatusTitle" Grid.Column="1" Text="尚未连接" FontSize="25" FontWeight="Bold"
                                 TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="StatusTitleOffset" /></TextBlock.RenderTransform>
                      </TextBlock>
                    </Grid>
                    <TextBlock x:Name="StatusDetail" Text="填写昵称，连接朋友分享的节点。"
                               TextWrapping="Wrap" Margin="0,12,0,0" FontSize="13" LineHeight="21"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Border x:Name="SupernodeBadge" Margin="0,9,0,0" Visibility="Collapsed"
                            ToolTip="当前连接的节点服务器；需要中转时由它转发数据。">
                      <TextBlock x:Name="SupernodeText" Text="节点：—" FontSize="12" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="NatTypeBadge" Grid.Column="2" Padding="16,14" CornerRadius="12"
                      Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="本机网络环境" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    <Button x:Name="NatHelp" Grid.Column="1" Width="28" Height="28" MinHeight="28"
                            Padding="0" Style="{StaticResource QuietButton}"
                            Click="NatHelp_Click" MouseEnter="NatHelp_MouseEnter" MouseLeave="NatHelp_MouseLeave"
                            PreviewKeyDown="NatHelp_PreviewKeyDown" LostKeyboardFocus="NatHelp_LostKeyboardFocus"
                            AutomationProperties.Name="直连条件说明"
                            AutomationProperties.HelpText="点击或按回车查看，按 Esc 关闭。">
                      <TextBlock Text="ⓘ" Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                    <Popup x:Name="NatHelpPopup" PlacementTarget="{Binding ElementName=NatHelp}" Placement="Bottom"
                           AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                      <Border Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource Border}"
                              BorderThickness="1" CornerRadius="9" Padding="14,12">
                        <StackPanel Width="320">
                          <TextBlock Text="直连条件" FontSize="14" FontWeight="SemiBold" />
                          <UniformGrid Columns="4" Margin="0,12,0,0">
                            <Border x:Name="Nat1LegendBorder" CornerRadius="7" Padding="0,8" Margin="0,0,5,0" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                              <StackPanel>
                                <TextBlock x:Name="Nat1LegendText" Text="NAT1" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="较少限制" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                              </StackPanel>
                            </Border>
                            <Border x:Name="Nat2LegendBorder" CornerRadius="7" Padding="0,8" Margin="0,0,5,0" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                              <StackPanel>
                                <TextBlock x:Name="Nat2LegendText" Text="NAT2" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="部分限制" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                              </StackPanel>
                            </Border>
                            <Border x:Name="Nat3LegendBorder" CornerRadius="7" Padding="0,8" Margin="0,0,5,0" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                              <StackPanel>
                                <TextBlock x:Name="Nat3LegendText" Text="NAT3" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="端口限制" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                              </StackPanel>
                            </Border>
                            <Border x:Name="Nat4LegendBorder" CornerRadius="7" Padding="0,8" BorderThickness="1"
                                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                              <StackPanel>
                                <TextBlock x:Name="Nat4LegendText" Text="NAT4" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="映射变化" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                              </StackPanel>
                            </Border>
                          </UniformGrid>
                          <TextBlock x:Name="NatExplainText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                     Text="连接后自动检测 NAT 类型。" />
                          <TextBlock x:Name="NetworkHintText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                     Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                    <TextBlock x:Name="NatHealthDot" Text="●" FontSize="8" VerticalAlignment="Center" Margin="0,0,7,0"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock x:Name="NatTypeText" Text="待检测" FontSize="21" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource TextPrimary}" />
                  </StackPanel>
                  <TextBlock x:Name="NatConditionText" Text="连接后自动检测" FontSize="12" Margin="0,5,0,0"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,15,24,18">
              <Grid UseLayoutRounding="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="VirtualIpLabel" Text="虚拟 IP" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock x:Name="VirtualIpText" Text="—" Style="{StaticResource MetricValueText}" MouseLeftButtonUp="VirtualIpText_MouseLeftButtonUp" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="在线朋友" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock x:Name="PeerCountText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="其中直连" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock x:Name="DirectCountText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <TextBlock Text="本次连接" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource MetricValueText}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TapWarningBorder" Grid.ColumnSpan="3" Background="{DynamicResource WarningSoft}"
                    BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="10"
                    Padding="13,10" Margin="0,0,0,18" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="需要安装虚拟网卡" FontWeight="SemiBold" />
                  <TextBlock x:Name="TapStatusText" Text="首次使用请先安装，完成后就不需要重复操作。"
                             Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,10,0" />
                </StackPanel>
                <Button x:Name="InstallTapButton" Grid.Column="1" Content="安装网络组件"
                        MinHeight="34" Padding="13,5" Click="InstallTapButton_Click" />
              </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,18">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="节点" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox x:Name="NodeBox" Grid.Column="1" DisplayMemberPath="Name"
                        SelectionChanged="NodeBox_SelectionChanged" ToolTipService.ShowOnDisabled="True"
                        ToolTip="选择要连接的节点" />
              <Button x:Name="ManageNodesButton" Grid.Column="2" Content="管理…" Margin="10,0,0,0"
                      Click="ManageNodes_Click" ToolTipService.ShowOnDisabled="True" />
              <Border x:Name="NoNodeBorder" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="还没有节点，请添加朋友分享的节点。" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <Button x:Name="AddFirstNodeButton" Grid.Column="1" Content="添加节点" Click="AddFirstNode_Click" />
                </Grid>
              </Border>
              <Grid x:Name="NodeDetailsPanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="NodeAddressText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" />
                <TextBlock x:Name="NodeCommunityText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" />
              </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="你的昵称" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="联机密钥" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBox x:Name="NicknameBox" Grid.Row="3" MaxLength="31" ToolTip="朋友列表中显示的名字"
                     ToolTipService.ShowOnDisabled="True"
                     TextChanged="NicknameBox_TextChanged" KeyDown="ConnectInput_KeyDown" />
            <Grid Grid.Row="3" Grid.Column="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="KeyBox" MaxLength="64"
                           ToolTip="朋友之间需使用相同密钥；留空表示不加密"
                           ToolTipService.ShowOnDisabled="True"
                           PasswordChanged="KeyBox_PasswordChanged" KeyDown="ConnectInput_KeyDown" />
              <TextBox x:Name="KeyPlainBox" MaxLength="64" Visibility="Collapsed"
                       ToolTip="朋友之间需使用相同密钥；留空表示不加密"
                       TextChanged="KeyPlainBox_TextChanged" KeyDown="ConnectInput_KeyDown" />
              <Button x:Name="KeyRevealButton" Grid.Column="1" Content="显示" Margin="6,0,0,0"
                      MinWidth="58" Style="{StaticResource QuietButton}"
                      AutomationProperties.Name="显示或隐藏联机密钥"
                      ToolTip="显示或隐藏密钥，方便核对朋友发来的内容"
                      Click="KeyRevealButton_Click" />
            </Grid>
            <TextBlock x:Name="NicknameHintText" Grid.Row="4" Text="朋友会通过这个名字辨认你。"
                       Margin="1,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            <CheckBox x:Name="RememberKeyBox" Grid.Row="4" Grid.Column="2"
                      Content="在这台电脑上安全记住密钥" Margin="1,7,0,0" />
            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,15,0,0">
              <TextBlock x:Name="NetworkSetupNoticeText" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondary}">
                <Run Text="不主动上报资料或日志；更新检查会访问 GitHub。" />
                <Hyperlink Click="OpenPrivacy_Click" Foreground="{DynamicResource AccentText}">隐私说明</Hyperlink>
              </TextBlock>
              <Button x:Name="ConnectButton" Margin="0,12,0,0" Height="50" Content="连接" FontSize="16"
                      Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" />
            </StackPanel>
            <TextBlock x:Name="ConnectErrorText" Grid.Row="6" Grid.ColumnSpan="3" Margin="2,10,0,0"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Danger}"
                       Visibility="Collapsed" />
          </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="联机好友" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="显示同一小组里也打开了 MikuN2N 的朋友；右键某一行可复制 IP 或切换线路。"
                           TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Border x:Name="DiscoveryBadge" Grid.Column="1" Background="{DynamicResource SuccessSoft}"
                      CornerRadius="11" Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed"
                      ToolTip="已连接时会自动发现同一小组里的朋友。">
                <TextBlock Text="自动发现中" Foreground="{DynamicResource SuccessText}" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <Button x:Name="PeerAssistRequestsButton" Grid.Column="2" Content="协助申请"
                      Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"
                      Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource AccentText}"
                      BorderBrush="{DynamicResource AccentText}" Click="PeerAssistRequests_Click"
                      ToolTip="朋友请求你协助转发；点击查看后可同意或拒绝。">
                <Button.ContentTemplate>
                  <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource AccentText}" /></DataTemplate>
                </Button.ContentTemplate>
              </Button>
            </Grid>
            <Grid>
              <DataGrid x:Name="PeersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        PreviewMouseWheel="PeersGrid_PreviewMouseWheel"
                        PreviewMouseRightButtonUp="PeersGrid_PreviewMouseRightButtonUp"
                        PreviewKeyDown="PeersGrid_PreviewKeyDown"
                        CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                        CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                        HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                        MinHeight="88" MaxHeight="228" RowHeight="38" ColumnHeaderHeight="34"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="昵称" Width="1.5*" MinWidth="100" SortMemberPath="Nickname">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ToolTip>
                            <ToolTip><StackPanel MaxWidth="320">
                              <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding VersionDetail}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel></ToolTip>
                          </Grid.ToolTip>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Nickname}" Style="{StaticResource CellText}" />
                          <Border x:Name="VersionWarning" Grid.Column="1" Visibility="Collapsed" Margin="6,0,0,0"
                                  Background="{DynamicResource WarningSoft}" CornerRadius="5" Padding="5,2" VerticalAlignment="Center">
                            <TextBlock Text="IPv6 协议不同" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                          </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Ipv6VersionMismatch}" Value="True">
                            <Setter TargetName="VersionWarning" Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="虚拟 IP" Width="118" SortMemberPath="VirtualIp">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding VirtualIp}" ToolTip="右键可复制虚拟 IP"
                                   Style="{StaticResource CellText}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="延迟" Binding="{Binding LatencyText}" Width="78"
                                      SortMemberPath="LatencyMs" ElementStyle="{StaticResource CellText}" />
                  <DataGridTemplateColumn Header="线路" Width="1.7*" MinWidth="128" SortMemberPath="ConnectionModeText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border x:Name="RouteBadge" Background="{DynamicResource SurfaceAlt}" CornerRadius="6"
                                Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGridCell}}">
                          <Border.ToolTip>
                            <ToolTip>
                              <StackPanel MaxWidth="280">
                                <TextBlock Text="{Binding ConnectionModeText}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConnectionModeDescription}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="右键可复制 IP、重新尝试直连或切换线路。"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondary}" />
                              </StackPanel>
                            </ToolTip>
                          </Border.ToolTip>
                          <TextBlock x:Name="RouteText" Text="{Binding ConnectionModeText}" FontSize="12"
                                     Style="{StaticResource CellText}" />
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.Direct}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource SuccessText}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.Ipv6Direct}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource SuccessText}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.LanDirect}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource SuccessText}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.Relayed}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource WarningSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.ForcedRelayed}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource WarningSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.PunchFailed}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource WarningSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.PeerAssisted}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource AccentText}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.Punching}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ConnectionMode}" Value="{x:Static models:PeerConnectionMode.Unknown}">
                            <Setter TargetName="RouteBadge" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72"
                                      ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="PeersEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False" Margin="12,34,12,0">
                <TextBlock Text="◎" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                <TextBlock x:Name="PeersEmptyDetail" Text="连接后，在线朋友会自动出现在这里。" Margin="0,5,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="4">
          <Border x:Name="DiagnosticsPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceAlt}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <DockPanel>
              <Button x:Name="StopUploadButton" DockPanel.Dock="Right" Content="停止上传" IsEnabled="False"
                      Click="StopUpload_Click" Margin="12,0,0,0" Padding="12,6" />
              <Button x:Name="ResumeDiagnosticsButton" DockPanel.Dock="Right" Content="恢复日志" IsEnabled="False"
                      Click="ResumeDiagnostics_Click" Margin="12,0,0,0" Padding="12,6"
                      ToolTip="恢复记录或重新授权上传，不会重连" />
              <TextBlock x:Name="DiagnosticsStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" />
            </DockPanel>
          </Border>
          <Expander Header="运行日志" Margin="3,0,3,0">
            <Border Background="{DynamicResource LogBackground}" CornerRadius="12" Padding="14" Margin="0,10,0,0">
              <DockPanel>
                <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="打开日志目录"
                        Style="{StaticResource QuietButton}" Foreground="{DynamicResource LogText}"
                        MinHeight="30" Padding="10,4" Margin="0,-6,-6,6" Click="OpenLogFolder_Click" />
                <TextBox x:Name="LogBox" Height="160" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         VerticalContentAlignment="Stretch"
                         Background="{DynamicResource LogBackground}" Foreground="{DynamicResource LogText}"
                         BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
              </DockPanel>
            </Border>
          </Expander>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Canvas x:Name="EasterEggOverlay" Panel.ZIndex="100" IsHitTestVisible="False" />
  </Grid>
</Window>
