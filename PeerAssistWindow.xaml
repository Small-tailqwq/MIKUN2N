<Window x:Class="MikuN2N.PeerAssistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="协助转发" Width="760" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
  <Window.Resources>
    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="24,36" />
    </Style>

    <!-- Tone is set by the row records: good / fair / poor / none / accent. -->
    <Style x:Key="BadgeBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="good">
          <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource SuccessSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="fair">
          <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource WarningSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="poor">
          <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DangerSoft}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="accent">
          <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="good">
          <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="fair">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="poor">
          <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="accent">
          <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The default ListBox template paints system greys; every brush here comes from the palette. -->
    <Style x:Key="CardList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CandidateItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,6,10" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="IsEnabled" Value="{Binding Candidate.Eligible}" />
      <Setter Property="ToolTip" Value="{Binding Details}" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" CornerRadius="12" BorderThickness="1.5"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RowHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.7" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Requests and sessions are acted on with their own buttons, so their rows are not selectable. -->
    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,6,10" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Style="{StaticResource CardStyle}" CornerRadius="12" Padding="16,14">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="协助转发" FontSize="22" FontWeight="Bold" />
      <TextBlock x:Name="TargetText" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}" FontSize="13" />
    </StackPanel>

    <TabControl x:Name="AssistTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,14,0,0">
      <TabItem x:Name="AskTab" Header="请朋友帮忙">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="AskIntroText" Style="{StaticResource HintText}" FontSize="12.5"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button x:Name="RefreshButton" Grid.Column="1" Content="重新测量" Click="Refresh_Click"
                    Style="{StaticResource QuietButton}" MinHeight="34" Padding="12,6" />
          </Grid>
          <ListBox x:Name="CandidatesList" Grid.Row="1" Style="{StaticResource CardList}"
                   ItemContainerStyle="{StaticResource CandidateItem}" SelectionMode="Single"
                   SelectionChanged="Candidate_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center" />
                    <Border Style="{StaticResource BadgeBorder}" Tag="accent" Margin="10,0,0,0"
                            Visibility="{Binding RecommendedVisibility}">
                      <TextBlock Text="推荐" Style="{StaticResource BadgeText}" />
                    </Border>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" Tag="{Binding QualityTone}">
                    <TextBlock Text="{Binding QualityLabel}" Style="{StaticResource BadgeText}" />
                  </Border>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RouteText}" Margin="0,8,0,0"
                             FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SummaryText}" Margin="0,4,0,0"
                             Style="{StaticResource HintText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="CandidatesEmptyText" Grid.Row="1" Style="{StaticResource EmptyText}" VerticalAlignment="Top"
                     Text="正在测量其他朋友的线路…" />
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="测量仅供参考，悬停查看详情。" />
            <Button x:Name="RequestButton" Grid.Column="1" Content="选择一位朋友" Style="{StaticResource PrimaryButton}"
                    MinWidth="150" IsEnabled="False" Click="Request_Click" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="RequestsTab" Header="收到的申请">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Style="{StaticResource HintText}" FontSize="12.5" Margin="0,0,0,12"
                     Text="仅协助本次申请，会占用你的带宽、可能影响游戏；可随时在“进行中”结束。" />
          <ListBox x:Name="RequestsList" Grid.Row="1" Style="{StaticResource CardList}"
                   ItemContainerStyle="{StaticResource PlainItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding RequesterNickname, StringFormat='{}{0} 请求协助'}"
                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TargetNickname, StringFormat='转发对象：{0}'}"
                               Style="{StaticResource HintText}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="拒绝" Tag="{Binding CircuitId}" Click="Decline_Click" Margin="0,0,8,0" />
                    <Button Content="同意协助" Tag="{Binding CircuitId}" Click="Accept_Click" Style="{StaticResource PrimaryButton}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="RequestsEmptyText" Grid.Row="1" Style="{StaticResource EmptyText}" VerticalAlignment="Top"
                     Text="暂无申请" />
        </Grid>
      </TabItem>

      <TabItem x:Name="SessionsTab" Header="进行中">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Style="{StaticResource HintText}" FontSize="12.5" Margin="0,0,0,12"
                     Text="结束协助后恢复原线路。" />
          <ListBox x:Name="SessionsList" Grid.Row="1" Style="{StaticResource CardList}"
                   ItemContainerStyle="{StaticResource PlainItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding RoleText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource BadgeBorder}" Tag="{Binding StateTone}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource BadgeText}" />
                  </Border>
                  <Button Grid.Column="2" Content="结束协助" Tag="{Binding CircuitId}" Click="Stop_Click" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SessionsEmptyText" Grid.Row="1" Style="{StaticResource EmptyText}" VerticalAlignment="Top"
                     Text="暂无协助" />
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="关闭会取消你发出的待同意申请，已开始的协助继续。"
                     Style="{StaticResource HintText}" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="关闭" Width="90" Click="Close_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
