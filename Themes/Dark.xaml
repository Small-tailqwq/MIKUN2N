<!-- Theme palette; keep the key set identical to Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackground" Color="#10151F" />
  <SolidColorBrush x:Key="Surface" Color="#181F2C" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#202837" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#242D3D" />
  <SolidColorBrush x:Key="Border" Color="#303B4D" />
  <SolidColorBrush x:Key="TextPrimary" Color="#F1F5FB" />
  <SolidColorBrush x:Key="TextSecondary" Color="#A7B1C3" />
  <SolidColorBrush x:Key="TextMuted" Color="#778399" />
  <SolidColorBrush x:Key="Accent" Color="#45D5CB" />
  <SolidColorBrush x:Key="AccentHover" Color="#63E2D9" />
  <SolidColorBrush x:Key="AccentSoft" Color="#14403D" />
  <SolidColorBrush x:Key="AccentText" Color="#45D5CB" />
  <SolidColorBrush x:Key="OnAccent" Color="#102A2E" />
  <SolidColorBrush x:Key="ButtonHover" Color="#28323F" />
  <SolidColorBrush x:Key="ButtonPressed" Color="#303B4B" />
  <SolidColorBrush x:Key="RowHover" Color="#1B2733" />
  <SolidColorBrush x:Key="Success" Color="#45C993" />
  <SolidColorBrush x:Key="SuccessSoft" Color="#173A31" />
  <SolidColorBrush x:Key="SuccessText" Color="#45C993" />
  <SolidColorBrush x:Key="Warning" Color="#F0B34E" />
  <SolidColorBrush x:Key="WarningSoft" Color="#3B3020" />
  <SolidColorBrush x:Key="Danger" Color="#F06B72" />
  <SolidColorBrush x:Key="DisconnectHover" Color="#C23A44" />
  <SolidColorBrush x:Key="DisconnectPressed" Color="#A82B35" />
  <SolidColorBrush x:Key="DangerSoft" Color="#42242D" />
  <SolidColorBrush x:Key="DangerText" Color="#FFADB3" />
  <SolidColorBrush x:Key="InputBackground" Color="#141B27" />
  <SolidColorBrush x:Key="LogBackground" Color="#0B1018" />
  <SolidColorBrush x:Key="LogText" Color="#D7DEEF" />
  <SolidColorBrush x:Key="Overlay" Color="#30000000" />
  <SolidColorBrush x:Key="ScrollTrack" Color="#26303B4D" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#A0778399" />

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#4FDCD2" Offset="0" />
    <GradientStop Color="#36C2B8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#6AE6DD" Offset="0" />
    <GradientStop Color="#45CFC5" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#36BDB3" Offset="0" />
    <GradientStop Color="#2AA69D" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
