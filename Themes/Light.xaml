<!-- Theme palette; Light.xaml and Dark.xaml must define the same keys. ThemeManager swaps
     one for the other at runtime, so consume these with DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackground" Color="#F3F6FA" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#F8FAFD" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Border" Color="#DFE5EE" />
  <SolidColorBrush x:Key="TextPrimary" Color="#172033" />
  <SolidColorBrush x:Key="TextSecondary" Color="#5E6A80" />
  <SolidColorBrush x:Key="TextMuted" Color="#929CAF" />
  <SolidColorBrush x:Key="Accent" Color="#1CAEA4" />
  <SolidColorBrush x:Key="AccentHover" Color="#17968D" />
  <SolidColorBrush x:Key="AccentSoft" Color="#DFF6F4" />
  <!-- Text on AccentSoft/SuccessSoft badges; the plain accent is too light to read there. -->
  <SolidColorBrush x:Key="AccentText" Color="#0B6F68" />
  <!-- Text and glyphs on Accent fills and the accent gradients; white reads at about 2.3:1 there. -->
  <SolidColorBrush x:Key="OnAccent" Color="#102A2E" />
  <SolidColorBrush x:Key="ButtonHover" Color="#E9EEF5" />
  <SolidColorBrush x:Key="ButtonPressed" Color="#DCE4F0" />
  <SolidColorBrush x:Key="RowHover" Color="#F0FAF8" />
  <SolidColorBrush x:Key="Success" Color="#2CB47D" />
  <SolidColorBrush x:Key="SuccessSoft" Color="#E5F7EF" />
  <SolidColorBrush x:Key="SuccessText" Color="#1B7A53" />
  <SolidColorBrush x:Key="Warning" Color="#D99728" />
  <SolidColorBrush x:Key="WarningSoft" Color="#FFF4D9" />
  <SolidColorBrush x:Key="Danger" Color="#E25259" />
  <SolidColorBrush x:Key="DangerSoft" Color="#FDECEE" />
  <SolidColorBrush x:Key="DangerText" Color="#A52D36" />
  <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LogBackground" Color="#151B29" />
  <SolidColorBrush x:Key="LogText" Color="#D7DEEF" />
  <SolidColorBrush x:Key="Overlay" Color="#12000000" />
  <SolidColorBrush x:Key="ScrollTrack" Color="#0F697489" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#78929CAF" />

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#41CFC5" Offset="0" />
    <GradientStop Color="#2BAEA4" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#4FDAD0" Offset="0" />
    <GradientStop Color="#33BCB1" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2FA89F" Offset="0" />
    <GradientStop Color="#21958C" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
