<Window x:Class="MikuN2N.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置与关于" Width="700" Height="620" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackground}">
  <Grid Margin="24" Background="{DynamicResource WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="2,0,0,18">
      <TextBlock Text="设置" FontSize="25" FontWeight="Bold" />
      <TextBlock Text="调整 MikuN2N 的外观和后台行为。" Margin="0,4,0,0"
                 Foreground="{DynamicResource TextSecondary}" />
    </StackPanel>

    <TabControl x:Name="SettingsTabs" Grid.Row="1" BorderThickness="0" Background="Transparent"
                SelectionChanged="SettingsTabs_SelectionChanged">
      <TabItem Header="节点">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="2,18,10,10">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="联机节点" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                           Text="MikuN2N 不自带服务器，请添加你自己搭建的 supernode，或朋友分享给你的地址。可以添加多个节点并在主界面切换，参与联机的双方必须填写同一个小组名称。" />
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <DataGrid x:Name="NodesGrid" MinHeight="180" MaxHeight="320"
                        AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                        CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column"
                        SelectionMode="Single" SelectionUnit="FullRow"
                        SelectionChanged="NodesGrid_SelectionChanged"
                        MouseDoubleClick="NodesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="节点名称" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="地址" Binding="{Binding Server}" Width="1.6*" />
                  <DataGridTextColumn Header="小组名称" Binding="{Binding Community}" Width="*" />
                  <DataGridTemplateColumn Header="当前" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ActiveMark}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Column="2" MinWidth="112">
                <Button Content="添加…" Click="AddNode_Click" />
                <Button x:Name="EditNodeButton" Content="编辑…" Margin="0,8,0,0" Click="EditNode_Click" />
                <Button x:Name="RemoveNodeButton" Content="删除" Margin="0,8,0,0" Click="RemoveNode_Click" />
                <Button x:Name="UseNodeButton" Content="设为当前" Margin="0,8,0,0" Click="UseNode_Click" />
              </StackPanel>
            </Grid>

            <TextBlock x:Name="NodesHintText" Margin="2,12,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="常规">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="2,18,10,10">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="应用主题" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="自动模式会跟随 Windows 的应用颜色，并在系统切换后自动更新。"
                             TextWrapping="Wrap" Margin="0,5,0,0"
                             Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                </StackPanel>
                <UniformGrid Grid.Column="1" Columns="3">
                  <RadioButton x:Name="ThemeSystemButton" GroupName="Theme" Content="自动"
                               Style="{StaticResource SegmentRadio}" Checked="ThemeButton_Checked" />
                  <RadioButton x:Name="ThemeLightButton" GroupName="Theme" Content="亮色"
                               Style="{StaticResource SegmentRadio}" Checked="ThemeButton_Checked" />
                  <RadioButton x:Name="ThemeDarkButton" GroupName="Theme" Content="暗色"
                               Style="{StaticResource SegmentRadio}" Checked="ThemeButton_Checked" />
                </UniformGrid>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="点击关闭按钮时" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="托盘图标会在程序运行期间保持可用，可随时显示窗口或彻底退出。"
                             TextWrapping="Wrap" Margin="0,5,0,0"
                             Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                </StackPanel>
                <UniformGrid Grid.Column="1" Columns="3">
                  <RadioButton x:Name="CloseAskButton" GroupName="CloseBehavior" Content="询问"
                               Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="CloseTrayButton" GroupName="CloseBehavior" Content="托盘"
                               Style="{StaticResource SegmentRadio}" />
                  <RadioButton x:Name="CloseExitButton" GroupName="CloseBehavior" Content="退出"
                               Style="{StaticResource SegmentRadio}" />
                </UniformGrid>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="实验功能" FontSize="16" FontWeight="SemiBold" />
                <CheckBox x:Name="ExperimentalIpv6Box" Content="尝试 IPv6 P2P 直连" Margin="0,12,0,0">
                  <CheckBox.Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                      <Style.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="双方开启后尝试使用 IPv6 直连，连接不通时自动使用原有线路。游戏仍使用虚拟局域网。保存后在下次连接时生效。"
                           TextWrapping="Wrap" Margin="0,7,0,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="165" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,22,0">
                  <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="连接日志保存在本机，可用于排查掉线和网络问题。"
                             Margin="0,5,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                </StackPanel>
                <ComboBox x:Name="LogRetentionBox" Grid.Column="1" Margin="0,0,12,0"
                          VerticalAlignment="Center" SelectedValuePath="Tag">
                  <ComboBoxItem Content="保留 7 天" Tag="7" />
                  <ComboBoxItem Content="保留 30 天" Tag="30" />
                  <ComboBoxItem Content="保留 90 天" Tag="90" />
                  <ComboBoxItem Content="保留 180 天" Tag="180" />
                  <ComboBoxItem Content="永久保留" Tag="0" />
                </ComboBox>
                <Button Grid.Column="2" Content="打开日志目录" Click="OpenLogs_Click" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="关于">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="2,18,10,10">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Accent}">
                  <TextBlock Text="M" Foreground="White" FontSize="25" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Miku " FontSize="21" FontWeight="Bold" />
                    <TextBlock x:Name="SlotFirstText" Text="N" FontSize="21" FontWeight="Bold" />
                    <TextBlock x:Name="SlotDigitText" Text="2" FontSize="21" FontWeight="Bold" />
                    <TextBlock x:Name="SlotLastText" Text="N" FontSize="21" FontWeight="Bold" />
                  </StackPanel>
                  <TextBlock x:Name="AboutVersionText" Margin="0,3,0,0"
                             Foreground="{DynamicResource TextSecondary}" Cursor="Hand"
                             MouseLeftButtonUp="AboutVersionText_MouseLeftButtonUp" />
                  <TextBlock Text="让朋友像在同一个局域网一样轻松联机。"
                             Margin="0,7,0,0" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock x:Name="EasterEggResultText" Margin="0,6,0,0" FontSize="11"
                             Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="开源组件" FontSize="17" FontWeight="SemiBold" Margin="2,4,0,10" />
            <Border Style="{StaticResource CardStyle}" Padding="20,8">
              <StackPanel>
                <Grid Margin="0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="n3n 3.4.4" FontWeight="SemiBold" />
                    <TextBlock Text="虚拟网络核心 · GPL-3.0-only" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="项目主页" Style="{StaticResource QuietButton}"
                          Tag="https://github.com/n42n/n3n" Click="OpenLink_Click" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}" />
                <Grid Margin="0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="TAP-Windows 9.24.7" FontWeight="SemiBold" />
                    <TextBlock Text="虚拟网卡驱动与安装器 · GPL-2.0（含 WDK 系统库例外）" FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="项目主页" Style="{StaticResource QuietButton}"
                          Tag="https://github.com/OpenVPN/tap-windows6" Click="OpenLink_Click" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}" />
                <Grid Margin="0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text=".NET 9 · WPF · Windows Forms" FontWeight="SemiBold" />
                    <TextBlock Text="桌面运行时与界面框架 · 源代码 MIT；Windows 自包含运行时依照 .NET Library License" FontSize="12" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="许可说明" Style="{StaticResource QuietButton}"
                          Tag="https://github.com/dotnet/core/blob/main/license-information.md" Click="OpenLink_Click" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
              <Button Content="查看随附 GPL 许可证" Click="OpenBundledLicense_Click" Margin="0,0,10,0" />
              <Button Content="复制版本信息" Click="CopyVersion_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click" />
      <Button Content="保存" Width="100" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
    </StackPanel>
    <Canvas x:Name="EasterEggOverlay" Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="False" />
  </Grid>
</Window>
